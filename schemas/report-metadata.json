{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeFi Audit Report Metadata",
  "description": "Public-facing audit findings. Fields describe the assessment outcome; they do not constitute financial advice.",
  "type": "object",
  "required": ["protocol", "chain", "auditDate", "auditor", "riskLevel", "securityScore", "securityGrade"],
  "properties": {
    "slug":           { "type": "string", "description": "Report filename slug (no extension)" },
    "protocol":       { "type": "string" },
    "protocolSlug":   { "type": "string" },
    "chain":          { "type": "string" },
    "auditDate":      { "type": "string" },
    "auditor":        { "type": "string" },
    "securityScore":  { "type": "number", "minimum": 0, "maximum": 100 },
    "securityGrade":  { "type": "string", "enum": ["A", "B", "C", "D", "E", "F", "N/A"] },
    "riskLevel":      { "type": "string", "enum": ["Critical", "High", "Medium", "Low", "Unknown"] },
    "dealBreakers":   { "type": "string", "description": "Headline summary, e.g. '3 Failed — Gate not cleared'" },

    "complexityTier":    { "type": "string", "description": "Simple / Moderate / Complex" },
    "frameworkVersion":  { "type": "string" },

    "dealBreakerGate":   { "type": "string", "enum": ["Pass", "Conditional", "Watchlist", "Fail", "Inconclusive"], "description": "Gate outcome — descriptive of the assessment result." },
    "monitoringCadence": { "type": "string", "enum": ["Daily", "Weekly", "Monthly", "Quarterly", "N/A"], "description": "Suggested follow-up cadence for re-running the assessment." },

    "dealBreakerDetails": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "status", "evidence"],
        "properties": {
          "item":     { "type": "string" },
          "status":   { "type": "string", "enum": ["PASS", "FAIL", "N/A", "Inconclusive"] },
          "evidence": { "type": "string" },
          "category": { "type": "string", "description": "Access Control / Oracle / Architecture / Audit / Economic / Cross-Chain" }
        }
      }
    },
    "dealBreakerSummary": {
      "type": "object",
      "properties": {
        "pass":         { "type": "number" },
        "fail":         { "type": "number" },
        "na":           { "type": "number" },
        "inconclusive": { "type": "number" }
      }
    },

    "openIssues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue", "category", "severity", "impact", "recommendation", "priority", "timeline"],
        "properties": {
          "issue":          { "type": "string" },
          "category":       { "type": "string" },
          "severity":       { "type": "string", "enum": ["Critical", "High", "Medium", "Low"] },
          "impact":         { "type": "string" },
          "recommendation": { "type": "string" },
          "priority":       { "type": "string", "enum": ["P0", "P1", "P2"] },
          "timeline":       { "type": "string" }
        }
      }
    },

    "adminControlMatrix": {
      "type": "array",
      "description": "Trust surfaces — who can affect funds and how fast",
      "items": {
        "type": "object",
        "required": ["surface", "controller", "controllerType", "delayHours", "worstCase"],
        "properties": {
          "surface":        { "type": "string" },
          "controller":     { "type": "string" },
          "controllerType": { "type": "string", "enum": ["EOA", "Multisig", "Governance", "Timelock", "Contract", "Unknown"] },
          "multisigConfig": { "type": "string", "description": "e.g. '4/9'" },
          "delayHours":     { "type": "number", "minimum": 0 },
          "worstCase":      { "type": "string" }
        }
      }
    },

    "accessControlRoles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contract": { "type": "string" },
          "role":     { "type": "string" },
          "holder":   { "type": "string" },
          "powers":   { "type": "string" }
        }
      }
    },

    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name":     { "type": "string" },
          "address":  { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
          "verified": { "type": "boolean" },
          "type":     { "type": "string" },
          "compiler": { "type": "string" }
        }
      }
    },

    "auditHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "firm", "tier"],
        "properties": {
          "date":  { "type": "string" },
          "firm":  { "type": "string" },
          "tier":  { "type": "integer", "minimum": 1, "maximum": 3, "description": "1=top-tier, 2=mid, 3=lower" },
          "scope": { "type": "string" },
          "findings": {
            "type": "object",
            "properties": {
              "critical": { "type": "number" },
              "high":     { "type": "number" },
              "medium":   { "type": "number" },
              "low":      { "type": "number" }
            }
          },
          "reportUrl": { "type": "string" }
        }
      }
    },

    "protocolMeta": {
      "type": "object",
      "properties": {
        "website":    { "type": "string" },
        "docs":       { "type": "string" },
        "github":     { "type": "string" },
        "type":       { "type": "string" },
        "subtype":    { "type": "string" },
        "tvlUsd":     { "type": ["number", "null"] },
        "tvlSource":  { "type": "string" },
        "launchDate": { "type": "string" }
      }
    },

    "bugBounty": {
      "type": ["object", "null"],
      "properties": {
        "provider":     { "type": "string" },
        "maxBountyUsd": { "type": ["number", "null"] },
        "url":          { "type": "string" }
      }
    },

    "keyFindings":     { "type": "array", "items": { "type": "string" } },
    "findingsSummary": { "type": "string", "description": "Plain-language summary of the audit findings — descriptive, not advisory." }
  }
}
