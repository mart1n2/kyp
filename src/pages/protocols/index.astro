---
import Layout from '../../components/Layout.astro';
import ProtocolCard from '../../components/ProtocolCard.astro';
import FilterPanel from '../../components/FilterPanel.astro';
import { getCollection } from 'astro:content';
import RelativeAge from '../../components/RelativeAge.astro';
import { parseAuditDate } from '../../utils/format';

const reports = await getCollection('reports');

const protocolMap = new Map();
for (const report of reports) {
  const pSlug = report.data.protocolSlug;
  if (!protocolMap.has(pSlug) || report.data.auditDate > protocolMap.get(pSlug).data.auditDate) {
    protocolMap.set(pSlug, report);
  }
}

const protocols = Array.from(protocolMap.values()).sort((a, b) => {
  const ta = parseAuditDate(a.data.auditDate)?.getTime() ?? 0;
  const tb = parseAuditDate(b.data.auditDate)?.getTime() ?? 0;
  return tb - ta || a.data.protocol.localeCompare(b.data.protocol);
});

// Header KPIs
const totalProtocols = protocols.length;
const chainsCovered = new Set(protocols.map(p => p.data.chain)).size;
const failingGates = protocols.filter(p => p.data.dealBreakerGate === 'Fail').length;

// protocols is sorted newest-audit-first, so the latest audit is the head.
const latestAuditDate = protocols[0]?.data.auditDate ?? null;

// Per-card precomputed stats
const cards = protocols.map(report => {
  const data = report.data;
  const failedDealBreakers = (data.dealBreakerDetails ?? []).filter((d: any) => d.status === 'FAIL').length;
  const eoaSurfaces = (data.adminControlMatrix ?? []).filter((s: any) => s.controllerType === 'EOA').length;
  return {
    data,
    failedDealBreakers,
    eoaSurfaces,
    contractsCount: (data.contracts ?? []).length,
    auditsCount: (data.auditHistory ?? []).length,
  };
});
---

<Layout title="Protocol Database — Permission Analysis" description="A filterable database of DeFi protocol permissions, trust surfaces, and audit findings. Technical reference only — not financial advice.">
  <section class="mb-8">
    <div class="inline-flex items-center gap-2 mb-3 px-2.5 py-1 rounded-full bg-accent/10 border border-accent/20 text-[11px] font-medium text-accent-2 uppercase tracking-wider">
      <span class="w-1.5 h-1.5 rounded-full bg-accent shadow-[0_0_8px_rgba(96,165,250,0.8)]"></span>
      {totalProtocols} protocol{totalProtocols === 1 ? '' : 's'} indexed
    </div>
    <h1 class="text-4xl sm:text-5xl font-extrabold mb-3 tracking-tight bg-gradient-to-br from-ink via-ink to-ink-3 bg-clip-text text-transparent">Protocol Database</h1>
    <p class="text-ink-3 max-w-2xl leading-relaxed">
      Structured permission analysis and audit findings for DeFi protocols — trust surfaces,
      deal-breaker gates, and contract inventories. Technical reference only — not financial advice.
    </p>

    <div class="mt-7 grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="kyp-kpi">
        <div class="kyp-label">Protocols Indexed</div>
        <div class="text-3xl font-extrabold mt-1.5 text-ink tracking-tight font-mono">{totalProtocols}</div>
      </div>
      <div class="kyp-kpi">
        <div class="kyp-label">Chains Covered</div>
        <div class="text-3xl font-extrabold mt-1.5 text-ink tracking-tight font-mono">{chainsCovered}</div>
      </div>
      <div class="kyp-kpi">
        <div class="kyp-label">Gate: Fail</div>
        <div class={`text-3xl font-extrabold mt-1.5 tracking-tight font-mono ${failingGates > 0 ? 'text-danger' : 'text-ink'}`}>{failingGates}</div>
      </div>
      <div class="kyp-kpi">
        <div class="kyp-label">Latest Audit</div>
        <div class="text-3xl font-extrabold mt-1.5 text-ink tracking-tight"><RelativeAge date={latestAuditDate} /></div>
      </div>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 mt-8">
    <div class="lg:col-span-1">
      <FilterPanel protocols={protocols} />
    </div>
    <div class="lg:col-span-3">
      <div class="flex items-center justify-between gap-3 mb-3 text-sm text-ink-3">
        <span id="match-count" aria-live="polite">{totalProtocols} protocol{totalProtocols === 1 ? '' : 's'}</span>
        <label class="flex items-center gap-2">
          <span class="text-xs text-ink-4">Sort</span>
          <select
            id="sort-select"
            class="bg-surface/60 border border-line-2 rounded-md text-xs text-ink-2 px-2 py-1.5 focus:outline-none focus:border-accent"
          >
            <option value="audit-desc">Newest audit</option>
            <option value="audit-asc">Oldest audit</option>
            <option value="score-desc">Highest score first</option>
            <option value="score-asc">Lowest score first</option>
            <option value="name">Name A–Z</option>
          </select>
        </label>
      </div>

      <div id="protocol-grid" class="grid gap-3 xl:grid-cols-2">
        {cards.map(c => (
          <ProtocolCard
            protocol={c.data.protocol}
            chain={c.data.chain}
            riskLevel={c.data.riskLevel}
            securityGrade={c.data.securityGrade}
            securityScore={c.data.securityScore}
            auditDate={c.data.auditDate}
            slug={c.data.protocolSlug}
            dealBreakerGate={c.data.dealBreakerGate}
            failedDealBreakers={c.failedDealBreakers}
            eoaSurfaces={c.eoaSurfaces}
            contractsCount={c.contractsCount}
            auditsCount={c.auditsCount}
          />
        ))}
      </div>

      <div id="empty-state" class="hidden p-8 bg-inset/40 border border-dashed border-line-2 rounded-lg text-center">
        <div class="text-ink-2 font-semibold mb-1">No protocols match the current filters</div>
        <p class="text-sm text-ink-4">Try clearing one or more filters.</p>
      </div>

      {totalProtocols === 0 && (
        <div class="p-8 bg-inset/40 border border-dashed border-line-2 rounded-lg text-center">
          <div class="text-ink-2 font-semibold mb-1">No protocols indexed yet</div>
          <p class="text-sm text-ink-4">Reports added to <code class="text-ink-3">src/content/reports/</code> will appear here.</p>
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  // Client-side sort for the protocol grid. Order-by values live in data
  // attributes rendered by ProtocolCard; filters (FilterPanel) only toggle
  // visibility, so sorting and filtering compose without coordination.
  (function () {
    const grid = document.getElementById('protocol-grid');
    const select = document.getElementById('sort-select') as HTMLSelectElement | null;
    if (!grid || !select) return;

    const num = (el: HTMLElement, key: string) => Number(el.dataset[key] ?? 0);
    const SORTS: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      'name': (a, b) => (a.dataset.protocolName ?? '').localeCompare(b.dataset.protocolName ?? ''),
      'score-asc': (a, b) => num(a, 'score') - num(b, 'score'),
      'score-desc': (a, b) => num(b, 'score') - num(a, 'score'),
      'audit-desc': (a, b) => num(b, 'auditTs') - num(a, 'auditTs'),
      'audit-asc': (a, b) => num(a, 'auditTs') - num(b, 'auditTs'),
    };

    const applySort = (updateUrl = true) => {
      const sorter = SORTS[select.value] ?? SORTS['audit-desc'];
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('a[data-protocol-card]'));
      cards.sort(sorter);
      grid.append(...cards);
      if (updateUrl) {
        const params = new URLSearchParams(location.search);
        if (select.value === 'audit-desc') params.delete('sort');
        else params.set('sort', select.value);
        const qs = params.toString();
        history.replaceState(null, '', qs ? `${location.pathname}?${qs}` : location.pathname);
      }
    };

    const fromUrl = new URLSearchParams(location.search).get('sort');
    if (fromUrl && SORTS[fromUrl]) {
      select.value = fromUrl;
      applySort(false);
    }
    select.addEventListener('change', () => applySort());
  })();
</script>
