---
import Layout from '../../components/Layout.astro';
import ProtocolHero from '../../components/ProtocolHero.astro';
import PageNav from '../../components/PageNav.astro';
import AdminControlMatrix from '../../components/AdminControlMatrix.astro';
import OpenIssuesBoard from '../../components/OpenIssuesBoard.astro';
import DealBreakerList from '../../components/DealBreakerList.astro';
import ContractList from '../../components/ContractList.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getCollection } from 'astro:content';
import { riskTextClass } from '../../utils/badges';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  const protocolMap = new Map();
  for (const report of reports) {
    const pSlug = report.data.protocolSlug;
    if (!protocolMap.has(pSlug) || report.data.auditDate > protocolMap.get(pSlug).data.auditDate) {
      protocolMap.set(pSlug, report);
    }
  }
  return Array.from(protocolMap.entries()).map(([slug, report]) => ({
    params: { slug },
    props: { report, protocolSlug: slug },
  }));
}

const { report, protocolSlug } = Astro.props;
const {
  protocol, chain, riskLevel, securityScore, securityGrade, auditDate,
  dealBreakerDetails, accessControlRoles, contracts, keyFindings, findingsSummary,
  dealBreakerGate,
  complexityTier,
  openIssues, auditHistory, adminControlMatrix,
  protocolMeta, bugBounty, dealBreakerSummary,
} = report.data;

const failedDealBreakers = dealBreakerDetails.filter(d => d.status === 'FAIL').length;
const totalDealBreakers = dealBreakerDetails.length;

const eoaSurfaces = adminControlMatrix.filter(s => s.controllerType === 'EOA');
const eoaSurfaceLabels = eoaSurfaces.map(s => s.surface);
const hasEoaControl = eoaSurfaces.length > 0
  || accessControlRoles.some(r => r.holder.includes('EOA'));

const openIssuesP0 = openIssues.filter(i => i.priority === 'P0').length;
const auditsTier1Count = auditHistory.filter(a => a.tier === 1).length;

const allReports = (await getCollection('reports'))
  .filter(r => r.data.protocolSlug === protocolSlug)
  .sort((a, b) => b.data.auditDate.localeCompare(a.data.auditDate));

const relatedNotes = (await getCollection('notes', ({ data }) => !data.draft && data.relatedProtocol === protocolSlug))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const dbCategories = Array.from(new Set(dealBreakerDetails.map(d => d.category).filter(Boolean))) as string[];
const groupedDB = dbCategories.length > 0
  ? dbCategories.map(cat => ({ category: cat, items: dealBreakerDetails.filter(d => d.category === cat) }))
  : [{ category: 'All', items: dealBreakerDetails }];

const dbStatusColor: Record<string, string> = {
  PASS: 'bg-ok/10 text-ok border-ok/40',
  FAIL: 'bg-danger/10 text-danger border-danger/40',
  'N/A': 'bg-ink/5 text-ink-3 border-line-2',
  Inconclusive: 'bg-warn/10 text-warn border-warn/40',
};

const sections = [
  ...(findingsSummary || keyFindings.length > 0 ? [{ id: 'findings', label: 'Findings' }] : []),
  ...(adminControlMatrix.length > 0 ? [{ id: 'trust', label: 'Trust Surfaces', count: adminControlMatrix.length }] : []),
  ...(dealBreakerDetails.length > 0 ? [{ id: 'deal-breakers', label: 'Deal Breakers', count: failedDealBreakers || undefined }] : []),
  ...(openIssues.length > 0 ? [{ id: 'open-issues', label: 'Open Issues', count: openIssues.length }] : []),
  ...(contracts.length > 0 ? [{ id: 'contracts', label: 'Contracts', count: contracts.length }] : []),
  ...(auditHistory.length > 0 ? [{ id: 'audits', label: 'Audits', count: auditHistory.length }] : []),
];
---

<Layout title={`${protocol} — Permission Analysis`} description={`Permission analysis and audit findings for ${protocol} on ${chain}`}>
  <div
    data-pagefind-body
    data-pagefind-meta={`title:${protocol} — Permission Analysis`}
  >
  <meta data-pagefind-meta="type:protocol" />
  <meta data-pagefind-meta={`protocol:${protocol}`} />
  <meta data-pagefind-meta={`chain:${chain}`} />
  <meta data-pagefind-meta={`gate:${dealBreakerGate}`} />
  <meta data-pagefind-meta={`risk:${riskLevel}`} />
  <JsonLd type="protocol" data={{ protocol, chain }} />
  <a href="/" class="text-sm text-accent hover:underline mb-4 inline-flex items-center gap-1">
    <span aria-hidden="true">←</span>
    <span>All protocols</span>
  </a>

  <ProtocolHero
    protocol={protocol}
    chain={chain}
    auditDate={auditDate}
    type={protocolMeta?.type}
    subtype={protocolMeta?.subtype}
    tvlUsd={protocolMeta?.tvlUsd ?? null}
    dealBreakerGate={dealBreakerGate}
    riskLevel={riskLevel}
    securityScore={securityScore}
    securityGrade={securityGrade}
    complexityTier={complexityTier}
    failedDealBreakers={failedDealBreakers}
    totalDealBreakers={totalDealBreakers}
    openIssuesP0={openIssuesP0}
    openIssuesTotal={openIssues.length}
    contractsCount={contracts.length}
    auditsCount={auditHistory.length}
    auditsTier1Count={auditsTier1Count}
    eoaSurfacesCount={eoaSurfaces.length}
    findingsSummary={findingsSummary}
    keyFindings={keyFindings}
  />

  {sections.length > 1 && <PageNav sections={sections} />}

  {hasEoaControl && (
    <aside class="mb-6 p-4 bg-danger/10 border border-danger/40 rounded-lg" role="alert">
      <div class="flex items-start gap-3">
        <span class="inline-flex w-6 h-6 shrink-0 items-center justify-center rounded-full bg-danger/15 ring-1 ring-danger/40 text-danger text-sm font-bold mt-0.5" aria-hidden="true">!</span>
        <div>
          <h3 class="font-semibold text-danger">EOA Control Detected</h3>
          <p class="text-sm text-danger/90 mt-1">
            Single externally-owned account controls{' '}
            <span class="font-mono">{eoaSurfaceLabels.length > 0 ? eoaSurfaceLabels.join(', ') : 'core surfaces'}</span>.
            A compromised key would enable instant fund loss with no on-chain delay.
          </p>
        </div>
      </div>
    </aside>
  )}

  <DealBreakerList dealBreakerDetails={dealBreakerDetails} />

  <div class="space-y-6">
    {adminControlMatrix.length > 0 && (
      <AdminControlMatrix surfaces={adminControlMatrix} chain={chain} />
    )}

    {dealBreakerDetails.length > 0 && (
      <section id="deal-breakers" class="kyp-panel scroll-mt-28">
        <div class="flex items-baseline justify-between mb-4 flex-wrap gap-2">
          <h2 class="text-xl font-bold">Deal Breaker Matrix</h2>
          {dealBreakerSummary && (
            <div class="flex flex-wrap gap-2 text-xs">
              <span class={`px-2 py-1 rounded border ${dbStatusColor.PASS}`}>PASS {dealBreakerSummary.pass}</span>
              <span class={`px-2 py-1 rounded border ${dbStatusColor.FAIL}`}>FAIL {dealBreakerSummary.fail}</span>
              <span class={`px-2 py-1 rounded border ${dbStatusColor['N/A']}`}>N/A {dealBreakerSummary.na}</span>
              <span class={`px-2 py-1 rounded border ${dbStatusColor.Inconclusive}`}>Inconclusive {dealBreakerSummary.inconclusive}</span>
            </div>
          )}
        </div>
        <div class="space-y-5">
          {groupedDB.map(group => (
            <div>
              {group.category !== 'All' && (
                <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-4 mb-2">{group.category}</h3>
              )}
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-line-2 text-ink-3 text-left">
                      <th class="pb-2 pr-4 font-semibold">Item</th>
                      <th class="pb-2 pr-4 font-semibold">Status</th>
                      <th class="pb-2 font-semibold">Evidence</th>
                    </tr>
                  </thead>
                  <tbody>
                    {group.items.map(d => (
                      <tr class="border-b border-line align-top">
                        <td class="py-2 pr-4 font-medium">{d.item}</td>
                        <td class="py-2 pr-4 whitespace-nowrap">
                          <span class={`px-2 py-0.5 rounded border text-xs font-semibold ${dbStatusColor[d.status] ?? dbStatusColor['N/A']}`}>
                            {d.status}
                          </span>
                        </td>
                        <td class="py-2 text-ink-3">{d.evidence}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {openIssues.length > 0 && (
      <section id="open-issues" class="scroll-mt-28">
        <OpenIssuesBoard issues={openIssues} />
      </section>
    )}

    {contracts.length > 0 && (
      <section id="contracts" class="scroll-mt-28">
        <ContractList contracts={contracts} chain={chain} />
      </section>
    )}

    {auditHistory.length > 0 && (
      <section id="audits" class="kyp-panel scroll-mt-28">
        <h2 class="text-xl font-bold mb-4">Audit History</h2>
        <div class="space-y-3">
          {auditHistory.map(a => {
            const tierLabel = a.tier === 1 ? 'Tier 1' : a.tier === 2 ? 'Tier 2' : 'Tier 3';
            const tierColor = a.tier === 1 ? 'bg-ok/10 text-ok border-ok/30'
                           : a.tier === 2 ? 'bg-info/10 text-info border-info/30'
                           : 'bg-ink/5 text-ink-2 border-line-2';
            const f = a.findings;
            return (
              <article class="kyp-inset p-4">
                <div class="flex flex-wrap items-center gap-2">
                  <span class={`px-2 py-0.5 rounded border text-xs font-semibold ${tierColor}`}>{tierLabel}</span>
                  <span class="font-semibold">{a.firm}</span>
                  <span class="text-ink-4 text-sm" aria-hidden="true">·</span>
                  <span class="text-sm text-ink-3">{a.date}</span>
                  {a.scope && (<><span class="text-ink-4 text-sm" aria-hidden="true">·</span><span class="text-sm text-ink-3">{a.scope}</span></>)}
                  {a.reportUrl && (
                    <a href={a.reportUrl} target="_blank" rel="noopener noreferrer" class="ml-auto text-xs text-accent hover:text-accent-2">Report ↗</a>
                  )}
                </div>
                {f && (f.critical + f.high + f.medium + f.low > 0) && (
                  <div class="mt-2 flex gap-3 text-xs">
                    {f.critical > 0 && <span class="text-danger">{f.critical} Critical</span>}
                    {f.high > 0 && <span class="text-hot">{f.high} High</span>}
                    {f.medium > 0 && <span class="text-warn">{f.medium} Medium</span>}
                    {f.low > 0 && <span class="text-ok">{f.low} Low</span>}
                  </div>
                )}
              </article>
            );
          })}
        </div>

        {(protocolMeta || bugBounty) && (
          <div class="mt-6 pt-6 border-t border-line-2 grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
            {protocolMeta && (
              <div class="space-y-1.5">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-4 mb-2">Protocol</h3>
                {protocolMeta.website && <div><span class="text-ink-4">Website:</span> <a href={protocolMeta.website} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-2">{protocolMeta.website} ↗</a></div>}
                {protocolMeta.docs && <div><span class="text-ink-4">Docs:</span> <a href={protocolMeta.docs} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-2">{protocolMeta.docs} ↗</a></div>}
                {protocolMeta.github && <div><span class="text-ink-4">GitHub:</span> <a href={protocolMeta.github} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-2">{protocolMeta.github} ↗</a></div>}
                {protocolMeta.launchDate && <div><span class="text-ink-4">Launched:</span> {protocolMeta.launchDate}</div>}
                {protocolMeta.tvlSource && <div><span class="text-ink-4">TVL Source:</span> {protocolMeta.tvlSource}</div>}
              </div>
            )}
            <div class="space-y-1.5">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-4 mb-2">Operations</h3>
              <div>
                <span class="text-ink-4">Bug Bounty:</span>{' '}
                {bugBounty ? (
                  <span class="text-ok">
                    {bugBounty.provider}
                    {bugBounty.maxBountyUsd ? ` — up to $${bugBounty.maxBountyUsd.toLocaleString()}` : ''}
                    {bugBounty.url ? <> — <a href={bugBounty.url} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-2">link ↗</a></> : null}
                  </span>
                ) : (
                  <span class="text-ink-3">None detected</span>
                )}
              </div>
            </div>
          </div>
        )}
      </section>
    )}

    {accessControlRoles.length > 0 && (
      <section class="kyp-panel">
        <details class="group">
          <summary class="cursor-pointer flex items-center justify-between gap-2 list-none">
            <span class="font-semibold text-ink-2">All role assignments ({accessControlRoles.length})</span>
            <span class="text-ink-3 group-open:rotate-180 transition-transform" aria-hidden="true">▾</span>
          </summary>
          <div class="overflow-x-auto mt-4">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-line-2 text-ink-3 text-left">
                  <th class="pb-2 pr-4 font-semibold">Contract</th>
                  <th class="pb-2 pr-4 font-semibold">Role</th>
                  <th class="pb-2 pr-4 font-semibold">Holder</th>
                  <th class="pb-2 font-semibold">Powers</th>
                </tr>
              </thead>
              <tbody>
                {accessControlRoles.map(r => (
                  <tr class="border-b border-line align-top">
                    <td class="py-2 pr-4 font-medium">{r.contract}</td>
                    <td class="py-2 pr-4 font-mono text-xs">{r.role}</td>
                    <td class={`py-2 pr-4 ${r.holder.includes('EOA') ? 'text-danger' : r.holder.includes('Safe') || r.holder.includes('multisig') ? 'text-ok' : 'text-ink-2'}`}>{r.holder}</td>
                    <td class="py-2 text-xs text-ink-3">{r.powers}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </section>
    )}

  </div>

  {relatedNotes.length > 0 && (
    <section class="mt-10 pt-6 border-t border-line-2">
      <div class="flex items-baseline justify-between mb-3">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-ink-4">Related notes</h2>
        <a href="/notes" class="text-xs text-accent hover:text-accent-2">All notes →</a>
      </div>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {relatedNotes.map(note => {
          const date = note.data.date.toISOString().slice(0, 10);
          return (
            <li>
              <a href={`/notes/${note.id}`} class="kyp-card block h-full p-4">
                <time datetime={date} class="text-[11px] uppercase tracking-wider text-ink-4 font-mono">{date}</time>
                <div class="text-sm font-semibold text-ink mt-1 leading-snug">{note.data.title}</div>
                {note.data.description && (
                  <p class="text-xs text-ink-3 mt-2 leading-relaxed line-clamp-2">{note.data.description}</p>
                )}
                <div class="flex flex-wrap items-center gap-1 mt-2 text-[11px]">
                  {note.data.tags.slice(0, 3).map(tag => (
                    <span class="kyp-tag">{tag}</span>
                  ))}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <section class="mt-10 pt-6 border-t border-line-2">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-ink-4 mb-3">All reports for {protocol}</h2>
    <ul class="space-y-2">
      {allReports.map(r => (
        <li>
          <a href={`/reports/${r.data.protocolSlug}/${r.data.slug}`} class="kyp-card block p-3">
            <div class="flex items-center justify-between gap-3">
              <span class="text-sm">{r.data.auditDate} — {r.data.securityGrade}</span>
              <span class={`text-xs font-semibold ${riskTextClass(r.data.riskLevel)}`}>{r.data.riskLevel}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
  </div>
</Layout>
