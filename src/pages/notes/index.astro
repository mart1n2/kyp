---
// The notes index moved to mart1n.xyz. Same canonical + meta-refresh treatment
// as the individual note stubs.
import { NOTES_HOME } from '../../utils/moved-notes';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Moved — {NOTES_HOME}</title>
    <link rel="canonical" href={NOTES_HOME} />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${NOTES_HOME}`} />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #020617;
        color: #cbd5e1;
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        padding: 2rem;
        text-align: center;
        line-height: 1.6;
      }
      a { color: #93c5fd; }
    </style>
  </head>
  <body>
    <main>
      <p>The research notes have moved to <a href={NOTES_HOME}>{NOTES_HOME}</a>.</p>
      <p style="font-size:0.875rem;color:#64748b">
        Redirecting… or return to the <a href="/">protocol database</a>.
      </p>
    </main>
  </body>
</html>
