---
/**
 * Redirect stubs for the notes that moved to mart1n.xyz.
 *
 * GitHub Pages can't issue a 301, so each old URL gets a page carrying a
 * canonical link plus a meta refresh — search engines treat that pairing as a
 * soft permanent redirect, and readers land on the right entry.
 *
 * The map is hardcoded on purpose: the notes collection no longer exists in
 * this repo, so there is nothing to derive it from. Slugs are frozen at the
 * moment of the move and should never need editing.
 */
import { MOVED_NOTES, NOTES_HOME } from '../../utils/moved-notes';

export async function getStaticPaths() {
  return Object.entries(MOVED_NOTES).map(([slug, destination]) => ({
    params: { slug },
    props: { destination },
  }));
}

const { destination } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Moved — {destination}</title>
    <link rel="canonical" href={destination} />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #020617;
        color: #cbd5e1;
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        padding: 2rem;
        text-align: center;
        line-height: 1.6;
      }
      a { color: #93c5fd; }
    </style>
  </head>
  <body>
    <main>
      <p>This writeup has moved to <a href={destination}>{destination}</a>.</p>
      <p style="font-size:0.875rem;color:#64748b">
        Redirecting… or browse all writing at <a href={NOTES_HOME}>{NOTES_HOME}</a>.
      </p>
    </main>
  </body>
</html>
