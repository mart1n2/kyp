---
import Layout from '../components/Layout.astro';
---

<Layout title="Page not found" description="The page you were looking for doesn't exist.">
  <div class="max-w-xl mx-auto text-center py-16">
    <div class="text-7xl font-extrabold font-mono tracking-tight bg-gradient-to-br from-white via-slate-200 to-slate-500 bg-clip-text text-transparent">404</div>
    <h1 class="text-xl font-bold mt-4">Page not found</h1>
    <p class="text-slate-400 mt-2 leading-relaxed">
      This page doesn't exist — it may have moved, or the protocol/note was renamed.
      Try the search above<span class="hidden sm:inline"> (<kbd class="px-1.5 py-0.5 text-[11px] font-mono bg-slate-800 border border-slate-700 rounded">⌘K</kbd>)</span>.
    </p>
    <div class="flex items-center justify-center gap-3 mt-8 text-sm">
      <a href="/" class="px-4 py-2 rounded-md bg-blue-500/15 border border-blue-500/30 text-blue-300 hover:bg-blue-500/25 transition-colors">All protocols</a>
      <a href="/notes" class="px-4 py-2 rounded-md bg-white/5 border border-white/10 text-slate-300 hover:bg-white/10 transition-colors">Notes</a>
    </div>
  </div>
</Layout>
