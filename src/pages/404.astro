---
import Layout from '../components/Layout.astro';
---

<Layout title="Page not found" description="The page you were looking for doesn't exist.">
  <div class="max-w-xl mx-auto text-center py-16">
    <div class="text-7xl font-extrabold font-mono tracking-tight bg-gradient-to-br from-ink via-ink-2 to-ink-4 bg-clip-text text-transparent">404</div>
    <h1 class="text-xl font-bold mt-4">Page not found</h1>
    <p class="text-ink-3 mt-2 leading-relaxed">
      This page doesn't exist — it may have moved, or the protocol was renamed.
      Try the search above<span class="hidden sm:inline"> (<kbd class="px-1.5 py-0.5 text-[11px] font-mono bg-ink/5 border border-line-2 rounded">⌘K</kbd>)</span>.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3 mt-8 text-sm">
      <a href="/" class="px-4 py-2 rounded-md bg-accent/15 border border-accent/30 text-accent-2 hover:bg-accent/25 transition-colors">Protocol database</a>
      <a href="/about" class="px-4 py-2 rounded-md bg-ink/5 border border-line text-ink-2 hover:bg-ink/10 transition-colors">About</a>
      <a href="https://www.mart1n.xyz" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-md bg-ink/5 border border-line text-ink-2 hover:bg-ink/10 transition-colors">Research notes ↗</a>
    </div>
  </div>
</Layout>
