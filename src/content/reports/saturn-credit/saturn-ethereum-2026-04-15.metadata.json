    { "item": "Unlimited Minting",              "status": "PASS", "category": "Smart Contract Architecture",  "evidence": "USDat minting controlled by underlying M token wrapping (1:1 backed). No unbacked path." },
    { "item": "Unsafe Delegatecall",            "status": "PASS", "category": "Smart Contract Architecture",  "evidence": "No delegatecall or unvalidated .call{} in Saturn contracts (only OZ proxy infrastructure)." },
    { "item": "Uninitialized Implementation",   "status": "PASS", "category": "Smart Contract Architecture",  "evidence": "All 5 implementations call _disableInitializers() in constructor." },
    { "item": "Unprotected Initializer",        "status": "PASS", "category": "Smart Contract Architecture",  "evidence": "All initialize() use initializer modifier; SwapFacility uses reinitializer(2) for V2." },

