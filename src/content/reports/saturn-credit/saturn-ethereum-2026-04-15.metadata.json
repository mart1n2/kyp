    { "item": "Timelock Backdoors",             "status": "FAIL", "category": "Access Control & Governance", "evidence": "Zero timelock on USDat, sUSDat, Withdraw, StrcPriceOracle admin ops. Only SwapFacility has 72h TimelockController. updateOracle() can instantly redirect price feed." },
    { "item": "No Emergency Controls",          "status": "PASS", "category": "Access Control & Governance", "evidence": "Pause/unpause implemented via COMPLIANCE_ROLE (pause) and DEFAULT_ADMIN_ROLE (unpause)." },

    { "item": "Direct Pool Price Oracle",       "status": "PASS", "category": "Oracle & Price Integrity",     "evidence": "Uses Chainlink STRC feed wrapped by StrcPriceOracle with staleness check (26h) and price bounds ($20-$150). Not a DEX spot price." },
    { "item": "Manual Price Control",           "status": "PASS", "category": "Oracle & Price Integrity",     "evidence": "Admin cannot set prices directly, but can call updateOracle() to change the oracle contract address — flagged as aggravating factor." },

    { "item": "Known Compiler Bugs",            "status": "PASS", "category": "Smart Contract Architecture",  "evidence": "Solidity 0.8.20 and 0.8.26. 198 files pass, 0 fail." },
