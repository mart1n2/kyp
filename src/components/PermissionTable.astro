---
interface Props {
  roles: Array<{ contract: string; role: string; holder: string; powers: string }>;
}

const { roles } = Astro.props;

const getAdminTypeColor = (holder: string) => {
  if (holder.includes('EOA')) return 'text-red-400';
  if (holder.includes('Safe') || holder.includes('multisig') || holder.includes('Gnosis')) return 'text-green-400';
  if (holder.includes('Governance') || holder.includes('DAO')) return 'text-blue-400';
  return 'text-slate-400';
};
---

<div class="bg-slate-800 rounded-lg p-6">
  <h2 class="text-xl font-bold mb-4">Permission Dashboard</h2>
  
  {roles.length > 0 ? (
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-700">
            <th class="pb-3 text-left font-semibold">Contract</th>
            <th class="pb-3 text-left font-semibold">Role</th>
            <th class="pb-3 text-left font-semibold">Holder</th>
            <th class="pb-3 text-left font-semibold">Powers</th>
          </tr>
        </thead>
        <tbody>
          {roles.map(role => (
            <tr class="border-b border-slate-700">
              <td class="py-3">{role.contract}</td>
              <td class="py-3 font-mono text-xs">{role.role}</td>
              <td class={`py-3 ${getAdminTypeColor(role.holder)}`}>
                {role.holder.substring(0, 30)}{role.holder.length > 30 ? '...' : ''}
              </td>
              <td class="py-3 text-xs text-slate-400">{role.powers}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <p class="text-slate-400">No access control data available</p>
  )}
</div>
