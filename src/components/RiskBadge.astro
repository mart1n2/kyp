---
interface Props {
  riskLevel: string;
  grade?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { riskLevel, grade, size = 'md' } = Astro.props;

const riskColors: Record<string, string> = {
  Critical: 'bg-red-600 text-white',
  High: 'bg-orange-600 text-white',
  Medium: 'bg-yellow-600 text-black',
  Low: 'bg-green-600 text-white',
};

const sizeClasses: Record<string, string> = {
  sm: 'px-2 py-0.5 text-xs',
  md: 'px-3 py-1 text-sm',
  lg: 'px-4 py-2 text-base',
};

const colorClass = riskColors[riskLevel] || 'bg-slate-600 text-white';
const sizeClass = sizeClasses[size];
---

<span class={`inline-flex items-center gap-2 font-semibold rounded ${colorClass} ${sizeClass}`}>
  {riskLevel}
  {grade && <span class="opacity-75">({grade})</span>}
</span>
