---
interface Props {
  dealBreakerDetails: Array<{ item: string; status: string; evidence: string; category?: string }>;
}

const { dealBreakerDetails } = Astro.props;
const failedItems = dealBreakerDetails.filter(d => d.status === 'FAIL');

if (failedItems.length === 0) return null;
---

<aside class="rounded-lg border border-red-800/70 bg-red-950/30 p-5 mb-6" aria-label="Critical deal-breaker failures">
  <div class="flex items-center gap-2 mb-3">
    <span class="inline-flex w-6 h-6 items-center justify-center rounded-full bg-red-900/60 ring-1 ring-red-700 text-red-200 text-sm font-bold" aria-hidden="true">!</span>
    <h2 class="text-lg font-bold text-red-200">{failedItems.length} Critical Deal-Breaker Failure{failedItems.length === 1 ? '' : 's'}</h2>
  </div>
  <ul class="space-y-2">
    {failedItems.map(item => (
      <li class="p-3 bg-red-950/50 border border-red-900/70 rounded">
        <div class="flex flex-wrap items-baseline gap-2 mb-0.5">
          <span class="font-semibold text-red-100">{item.item}</span>
          {item.category && <span class="text-[11px] text-red-300/80">{item.category}</span>}
        </div>
        <div class="text-sm text-red-200/90">{item.evidence}</div>
      </li>
    ))}
  </ul>
</aside>
