---
interface Props {
  dealBreakerDetails: Array<{ item: string; status: string; evidence: string; category?: string }>;
}

const { dealBreakerDetails } = Astro.props;
const failedItems = dealBreakerDetails.filter(d => d.status === 'FAIL');

if (failedItems.length === 0) return null;
---

<aside class="rounded-lg border border-danger/30 bg-danger/10 p-5 mb-6" aria-label="Critical deal-breaker failures">
  <div class="flex items-center gap-2 mb-3">
    <span class="inline-flex w-6 h-6 items-center justify-center rounded-full bg-danger/15 ring-1 ring-danger/40 text-danger text-sm font-bold" aria-hidden="true">!</span>
    <h2 class="text-lg font-bold text-danger">{failedItems.length} Critical Deal-Breaker Failure{failedItems.length === 1 ? '' : 's'}</h2>
  </div>
  <ul class="space-y-2">
    {failedItems.map(item => (
      <li class="p-3 bg-danger/10 border border-danger/30 rounded-md">
        <div class="flex flex-wrap items-baseline gap-2 mb-0.5">
          <span class="font-semibold text-danger">{item.item}</span>
          {item.category && <span class="text-[11px] text-danger/80">{item.category}</span>}
        </div>
        <div class="text-sm text-danger/90">{item.evidence}</div>
      </li>
    ))}
  </ul>
</aside>
