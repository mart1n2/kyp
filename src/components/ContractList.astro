---
import { explorerUrlFor } from '../utils/badges';

interface Props {
  contracts: Array<{ name: string; address: string; verified: boolean; type: string; compiler: string }>;
  chain?: string;
}

const { contracts, chain = 'Ethereum' } = Astro.props;
const explorerUrl = explorerUrlFor(chain);
---

<div class="kyp-panel">
  <h2 class="text-xl font-bold mb-4">Contract Inventory</h2>

  {contracts.length > 0 ? (
    <div class="space-y-3">
      {contracts.map(contract => (
        <div class="kyp-inset p-3">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <div class="font-semibold">{contract.name}</div>
              <a href={`${explorerUrl}${contract.address}`} target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-blue-400 hover:text-blue-300 mt-1 inline-block break-all">{contract.address} ↗</a>
            </div>
            <div class="flex gap-1.5 text-xs shrink-0">
              {contract.verified ? (
                <span class="px-2 py-0.5 rounded border bg-green-900/40 text-green-200 border-green-800 font-medium">Verified</span>
              ) : (
                <span class="px-2 py-0.5 rounded border bg-red-900/40 text-red-200 border-red-800 font-medium">Unverified</span>
              )}
              {contract.type.includes('Proxy') && (
                <span class="px-2 py-0.5 rounded border bg-blue-900/40 text-blue-200 border-blue-800 font-medium">Proxy</span>
              )}
            </div>
          </div>
          {contract.compiler && (
            <div class="text-xs text-slate-500 mt-2 font-mono">Compiler: {contract.compiler}</div>
          )}
        </div>
      ))}
    </div>
  ) : (
    <p class="text-slate-400">No contract data available</p>
  )}
</div>
