---
import { relativeAge, parseAuditDate } from '../utils/format';
import { riskTextClass, scoreTextClass } from '../utils/badges';
import GateBadge from './GateBadge.astro';

interface Props {
  protocol: string;
  chain: string;
  riskLevel: string;
  securityGrade: string;
  securityScore?: number;
  auditDate: string;
  slug: string;
  dealBreakerGate?: string;
  failedDealBreakers?: number;
  eoaSurfaces?: number;
  contractsCount?: number;
  auditsCount?: number;
}

const {
  protocol, chain, riskLevel, securityGrade, securityScore,
  auditDate, slug,
  dealBreakerGate = 'Inconclusive',
  failedDealBreakers = 0,
  eoaSurfaces = 0,
  contractsCount = 0,
  auditsCount = 0,
} = Astro.props;

const age = relativeAge(auditDate);
const auditTimestamp = parseAuditDate(auditDate)?.getTime() ?? 0;
---

<a
  href={`/protocols/${slug}`}
  data-protocol-card
  data-chain={chain}
  data-risk={riskLevel}
  data-gate={dealBreakerGate}
  data-protocol-name={protocol.toLowerCase()}
  data-score={securityScore ?? -1}
  data-audit-ts={auditTimestamp}
  class="group kyp-card block p-5"
>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2 mb-1">
        <h3 class="text-lg font-semibold truncate">{protocol}</h3>
        <GateBadge gate={dealBreakerGate} prefix size="xs" />
      </div>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-xs text-slate-400">
        <span>{chain}</span>
        <span aria-hidden="true">·</span>
        <span>{age || auditDate}</span>
        <span aria-hidden="true">·</span>
        <span>{contractsCount} contract{contractsCount === 1 ? '' : 's'}</span>
        <span aria-hidden="true">·</span>
        <span>{auditsCount} audit{auditsCount === 1 ? '' : 's'}</span>
      </div>
    </div>
    <div class="text-right shrink-0">
      <div class={`text-xl font-extrabold leading-none ${riskTextClass(riskLevel)}`}>
        {riskLevel}
      </div>
      <div class="text-xs text-slate-500 mt-0.5">
        Score <span class={`font-semibold ${scoreTextClass(securityScore)}`}>{securityScore ?? '—'}</span> · Grade <span class="text-slate-300 font-semibold">{securityGrade}</span>
      </div>
    </div>
  </div>

  {(failedDealBreakers > 0 || eoaSurfaces > 0) && (
    <div class="mt-3 pt-3 border-t border-slate-700/60 flex flex-wrap gap-1.5 text-[11px]">
      {failedDealBreakers > 0 && (
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded border bg-red-950/50 text-red-200 border-red-800/70">
          <span class="font-semibold">{failedDealBreakers}</span>
          <span class="opacity-80">deal-breaker FAIL{failedDealBreakers === 1 ? '' : 's'}</span>
        </span>
      )}
      {eoaSurfaces > 0 && (
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded border bg-red-950/50 text-red-200 border-red-800/70">
          <span class="font-semibold">{eoaSurfaces}</span>
          <span class="opacity-80">EOA surface{eoaSurfaces === 1 ? '' : 's'}</span>
        </span>
      )}
    </div>
  )}
</a>
