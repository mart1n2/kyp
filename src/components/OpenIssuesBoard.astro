---
interface Issue {
  issue: string;
  category: string;
  severity: 'Critical' | 'High' | 'Medium' | 'Low';
  impact: string;
  recommendation: string;
  priority: 'P0' | 'P1' | 'P2';
  timeline: string;
}

interface Props {
  issues: Issue[];
}

const { issues } = Astro.props;

const priorityOrder = { P0: 0, P1: 1, P2: 2 };
const sorted = [...issues].sort((a, b) => priorityOrder[a.priority] - priorityOrder[b.priority]);

import { severityTextClass } from '../utils/badges';

const priorityStyle: Record<string, string> = {
  P0: 'bg-danger/10 text-danger border-danger/40',
  P1: 'bg-hot/10 text-hot border-hot/40',
  P2: 'bg-warn/10 text-warn border-warn/40',
};

const counts = sorted.reduce(
  (acc, i) => ({ ...acc, [i.priority]: (acc[i.priority] || 0) + 1 }),
  {} as Record<string, number>
);
---

<div class="kyp-panel">
  <div class="flex items-baseline justify-between mb-4">
    <h2 class="text-xl font-bold">Open Issues</h2>
    <div class="flex gap-2 text-xs">
      {(['P0','P1','P2'] as const).map(p =>
        counts[p] ? (
          <span class={`px-2 py-1 rounded border font-semibold ${priorityStyle[p]}`}>{p}: {counts[p]}</span>
        ) : null
      )}
    </div>
  </div>

  {sorted.length > 0 ? (
    <ul class="space-y-3">
      {sorted.map(issue => (
        <li class="kyp-inset p-4">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <span class={`px-2 py-0.5 rounded border text-xs font-semibold ${priorityStyle[issue.priority]}`}>{issue.priority}</span>
            <span class={`text-xs font-semibold ${severityTextClass(issue.severity)}`}>{issue.severity}</span>
            <span class="text-xs text-ink-4">·</span>
            <span class="text-xs text-ink-3">{issue.category}</span>
            <span class="ml-auto text-xs text-ink-3">Timeline: <span class="text-ink-2">{issue.timeline}</span></span>
          </div>
          <div class="font-semibold text-ink">{issue.issue}</div>
          <div class="text-sm text-ink-3 mt-1"><span class="text-ink-4">Impact:</span> {issue.impact}</div>
          <div class="text-sm text-ink-2 mt-1"><span class="text-ink-4">Recommendation:</span> {issue.recommendation}</div>
        </li>
      ))}
    </ul>
  ) : (
    <p class="text-ink-3">No open issues recorded</p>
  )}
</div>
