---
interface Props {
  protocols: any[];
}

const { protocols } = Astro.props;

const chainCounts = new Map<string, number>();
const riskCounts = new Map<string, number>();
const gateCounts = new Map<string, number>();
for (const p of protocols) {
  const d = p.data;
  chainCounts.set(d.chain, (chainCounts.get(d.chain) ?? 0) + 1);
  riskCounts.set(d.riskLevel, (riskCounts.get(d.riskLevel) ?? 0) + 1);
  gateCounts.set(d.dealBreakerGate ?? 'Inconclusive', (gateCounts.get(d.dealBreakerGate ?? 'Inconclusive') ?? 0) + 1);
}

const chains = Array.from(chainCounts.keys()).sort();
const riskLevels = ['Critical', 'High', 'Medium', 'Low'];
const gates = ['Pass', 'Conditional', 'Watchlist', 'Fail', 'Inconclusive'];

const groups = [
  { legend: 'Gate Outcome', cls: 'filter-gate', items: gates.map(g => ({ value: g, count: gateCounts.get(g) ?? 0 })) },
  { legend: 'Chain', cls: 'filter-chain', items: chains.map(c => ({ value: c, count: chainCounts.get(c) ?? 0 })) },
  { legend: 'Risk Level', cls: 'filter-risk', items: riskLevels.map(r => ({ value: r, count: riskCounts.get(r) ?? 0 })) },
];
---

<aside class="lg:sticky lg:top-[calc(var(--header-h)+16px)] lg:max-h-[calc(100vh-var(--header-h)-2rem)] lg:overflow-y-auto">
  <details data-filter-details class="group rounded-lg border border-line bg-surface/60 lg:border-0 lg:bg-transparent lg:rounded-none">
    <summary class="lg:hidden flex items-center justify-between gap-2 px-4 py-3 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
      <span class="text-sm font-semibold uppercase tracking-wider text-ink-3">Filters</span>
      <span class="flex items-center gap-2">
        <span data-active-filter-count class="hidden px-1.5 py-0.5 rounded-full bg-accent/15 border border-accent/30 text-accent-2 text-[11px] font-semibold leading-none"></span>
        <span class="text-ink-4 transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
      </span>
    </summary>

    <div class="px-4 pb-4 pt-1 lg:p-0 space-y-5">
      <div class="flex items-center justify-between">
        <h2 class="hidden lg:block text-sm font-semibold uppercase tracking-wider text-ink-3">Filters</h2>
        <button
          type="button"
          data-clear-filters
          class="text-xs text-ink-4 hover:text-accent-2 disabled:opacity-40 disabled:cursor-not-allowed ml-auto"
          disabled
        >
          Clear all
        </button>
      </div>

      {groups.map(group => (
        <fieldset>
          <legend class="font-semibold mb-2 text-ink-2">{group.legend}</legend>
          <ul class="space-y-1.5">
            {group.items.map(({ value, count }) => (
              <li>
                <label class="flex items-center justify-between gap-2 group/item cursor-pointer text-sm">
                  <span class="flex items-center gap-2">
                    <input type="checkbox" value={value} class={`${group.cls} rounded accent-[rgb(var(--c-accent))]`} disabled={count === 0} />
                    <span class={count === 0 ? 'text-ink-4' : 'text-ink-2 group-hover/item:text-ink'}>{value}</span>
                  </span>
                  <span class="text-xs text-ink-4 font-mono">{count}</span>
                </label>
              </li>
            ))}
          </ul>
        </fieldset>
      ))}
    </div>
  </details>
</aside>

<script>
  (function () {
    const sel = (cls: string) =>
      Array.from(document.querySelectorAll<HTMLInputElement>(`.${cls}:checked`)).map(el => el.value);

    const clearBtn = document.querySelector<HTMLButtonElement>('[data-clear-filters]');
    const allBoxes = () => Array.from(document.querySelectorAll<HTMLInputElement>('.filter-gate, .filter-chain, .filter-risk'));
    const matchCountEl = document.getElementById('match-count');
    const emptyStateEl = document.getElementById('empty-state');
    const grid = document.getElementById('protocol-grid');
    const activeCountEl = document.querySelector<HTMLElement>('[data-active-filter-count]');

    const PARAMS: Array<[string, string]> = [['filter-gate', 'gate'], ['filter-chain', 'chain'], ['filter-risk', 'risk']];

    const syncUrl = () => {
      const params = new URLSearchParams(location.search);
      for (const [cls, key] of PARAMS) {
        const values = sel(cls);
        if (values.length > 0) params.set(key, values.join(','));
        else params.delete(key);
      }
      const qs = params.toString();
      history.replaceState(null, '', qs ? `${location.pathname}?${qs}` : location.pathname);
    };

    const readUrl = () => {
      const params = new URLSearchParams(location.search);
      let any = false;
      for (const [cls, key] of PARAMS) {
        const values = (params.get(key) ?? '').split(',').filter(Boolean);
        if (values.length === 0) continue;
        document.querySelectorAll<HTMLInputElement>(`.${cls}`).forEach(box => {
          if (values.includes(box.value) && !box.disabled) {
            box.checked = true;
            any = true;
          }
        });
      }
      return any;
    };

    const apply = (updateUrl = true) => {
      const chains = sel('filter-chain');
      const risks = sel('filter-risk');
      const gates = sel('filter-gate');

      const cards = document.querySelectorAll<HTMLElement>('a[data-protocol-card]');
      let visible = 0;
      cards.forEach(card => {
        const chain = card.dataset.chain ?? '';
        const risk = card.dataset.risk ?? '';
        const gate = card.dataset.gate ?? '';

        const ok =
          (chains.length === 0 || chains.includes(chain)) &&
          (risks.length === 0 || risks.includes(risk)) &&
          (gates.length === 0 || gates.includes(gate));

        card.style.display = ok ? '' : 'none';
        if (ok) visible++;
      });

      const total = cards.length;
      if (matchCountEl) {
        matchCountEl.textContent = visible === total
          ? `${total} protocol${total === 1 ? '' : 's'}`
          : `${visible} of ${total} protocol${total === 1 ? '' : 's'}`;
      }
      if (emptyStateEl && grid) {
        const isEmpty = visible === 0 && total > 0;
        emptyStateEl.classList.toggle('hidden', !isEmpty);
        grid.classList.toggle('hidden', isEmpty);
      }

      const activeCount = chains.length + risks.length + gates.length;
      if (clearBtn) clearBtn.disabled = activeCount === 0;
      if (activeCountEl) {
        activeCountEl.textContent = String(activeCount);
        activeCountEl.classList.toggle('hidden', activeCount === 0);
      }
      if (updateUrl) syncUrl();
    };

    document.addEventListener('change', e => {
      const t = e.target as HTMLInputElement;
      if (t && (t.classList.contains('filter-gate') || t.classList.contains('filter-chain') || t.classList.contains('filter-risk'))) {
        apply();
      }
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        allBoxes().forEach(b => { if (b.checked) b.checked = false; });
        apply();
      });
    }

    // Collapsed on mobile, always open on desktop.
    const details = document.querySelector<HTMLDetailsElement>('[data-filter-details]');
    if (details) {
      const mq = window.matchMedia('(min-width: 1024px)');
      const syncOpen = () => { details.open = mq.matches || details.open; };
      mq.addEventListener('change', syncOpen);
      syncOpen();
    }

    const hadUrlState = readUrl();
    // Open the mobile panel when arriving on a shared filtered link, so the
    // active filters are visible.
    if (hadUrlState && details && !details.open) details.open = true;
    apply(false);
  })();
</script>
