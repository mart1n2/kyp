---
interface Props {
  kind?: 'incident' | 'research' | 'essay';
  incident?: {
    loss?: string;
    scope?: string;
    status?: string;
  };
  size?: 'sm' | 'md';
}

const { kind = 'essay', incident, size = 'md' } = Astro.props;

if (kind === 'essay') return Astro.slots.has('default') ? Astro.slots.render('default') : null;

const palette: Record<string, string> = {
  incident: 'bg-red-500/12 text-red-200 border-red-500/30',
  research: 'bg-amber-500/12 text-amber-200 border-amber-500/30',
};

const label: Record<string, string> = {
  incident: 'Incident',
  research: 'Security Research',
};

const icon: Record<string, string> = {
  incident: '⚠',
  research: '◆',
};

const padding = size === 'sm' ? 'px-1.5 py-0.5 text-[10px]' : 'px-2 py-0.5 text-[11px]';

// Compose right-side detail strip from any provided incident fields.
const details: string[] = [];
if (kind === 'incident' && incident) {
  if (incident.scope) details.push(incident.scope);
  if (incident.loss) details.push(incident.loss);
  if (incident.status && incident.status !== 'post-mortem') details.push(incident.status);
}
---

<span class={`inline-flex items-center gap-1.5 rounded border font-semibold uppercase tracking-wider ${palette[kind]} ${padding}`}>
  <span aria-hidden="true">{icon[kind]}</span>
  <span>{label[kind]}</span>
  {details.length > 0 && (
    <>
      <span class="opacity-40" aria-hidden="true">·</span>
      <span class="font-mono normal-case tracking-normal opacity-90">{details.join(' · ')}</span>
    </>
  )}
</span>
