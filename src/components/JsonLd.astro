---
interface Props {
  type: 'protocol' | 'report' | 'note';
  data: Record<string, any>;
}

const { type, data } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

let jsonLd = {};

if (type === 'protocol') {
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": data.protocol,
    "description": `DeFi protocol on ${data.chain} - Security analysis and audit reports`,
    "url": pageUrl,
    "knowsAbout": data.chain,
  };
} else if (type === 'note') {
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": data.title,
    "description": data.description ?? data.title,
    "datePublished": data.date,
    ...(data.updated ? { "dateModified": data.updated } : {}),
    "url": pageUrl,
    "author": {
      "@type": "Organization",
      "name": "Know Your Protocol",
    },
  };
} else if (type === 'report') {
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": `${data.protocol} Security Audit Report`,
    "description": `Security audit report for ${data.protocol} on ${data.chain}`,
    "datePublished": data.auditDate,
    "author": {
      "@type": "Organization",
      "name": "Know Your Protocol",
    },
    "about": {
      "@type": "SoftwareApplication",
      "name": data.protocol,
      "applicationCategory": "FinanceApplication",
    },
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
